# Where the collector pushes aggregated usage. Leave empty to run local-only
# (still writes ~/.claude-usage/summary.json, just no cloud push).
DASHBOARD_URL=https://your-dashboard.vercel.app

# Shared secret that must match the dashboard's INGEST_TOKEN.
INGEST_TOKEN=change-me

# Optional: override the Claude data directory (defaults to ~/.claude).
# CLAUDE_HOME=/Users/you/.claude

# Optional: set to "1" to attempt the best-effort live "% remaining" endpoint.
ENABLE_LIVE_USAGE=1
